# ================================================================
# FCV TRAINING LAB · Proyecto de citas
# Copia este archivo a .env. NO subas .env a Git.
# ================================================================
COMPOSE_PROJECT_NAME=fcv-citas-training

MYSQL_DATABASE=citas_fcv_training
MYSQL_USER=citas_app
MYSQL_PASSWORD=CitasApp_2026!
MYSQL_ROOT_PASSWORD=RootCitas_2026!
MYSQL_PORT=3307

API_PORT=8080
REACT_PORT=5173
ANGULAR_PORT=4200

# Valores que usará el backend cuando sea implementado por el estudiante.
DB_HOST=mysql
DB_PORT=3307
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CitasApp_2026!

# Secreto del JWT de acceso, de LABORATORIO. Sustituir en cada repo personal.
# El refresh token es opaco (DEC-002): no se firma, por eso no hay secreto de refresco.
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Primer ADMIN (decision D5, S3). citas-api lo crea al arrancar solo si no existe ninguno.
# Pon un correo y una contrasena propios en tu .env; aqui se quedan vacios.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# URL pública usada por el frontend cuando corra en el host.
VITE_API_URL=http://localhost:8080

# Origen exacto del frontend para CORS. Nunca usar comodin (PRD seccion 8).
FRONTEND_ORIGIN=http://localhost:5173
